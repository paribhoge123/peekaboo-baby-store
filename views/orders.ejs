<!DOCTYPE html>
<html>
<head>

    <title>Orders</title>

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

<style>

@import url('https://fonts.googleapis.com/css2?family=Fredoka:wght@300..700&family=Pacifico&display=swap');

body{
    margin:0;
    background:#fff7f2;
    font-family:'Fredoka', sans-serif;
    color:#333;
}

/* CONTAINER */

.container{
    padding:40px 6%;
}

/* TITLE */

.orders-title{
    text-align:center;
    font-size:55px;
    color:#4a3434;
    margin-bottom:40px;
    font-family:'Pacifico', cursive;
}

/* ORDER CARD */

.order-card{
    background:#fffaf7;
    border-radius:30px;
    padding:30px;
    margin-bottom:30px;
    box-shadow:0 8px 20px rgba(0,0,0,0.06);
    transition:0.3s;
}

.order-card:hover{
    transform:translateY(-5px);
}

/* ORDER HEADER */

.order-header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:25px;
    flex-wrap:wrap;
    gap:10px;
}

.order-total{
    font-size:32px;
    color:#4a3434;
    font-weight:bold;
}

.order-badge{
    background:#f3c8aa;
    color:white;
    padding:10px 18px;
    border-radius:30px;
    font-size:14px;
    font-weight:bold;
}

/* PRODUCTS */

.order-products{
    display:flex;
    flex-direction:column;
    gap:18px;
}

/* PRODUCT ITEM */

.product-item{
    background:white;
    border-radius:20px;
    padding:18px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    box-shadow:0 4px 10px rgba(0,0,0,0.04);
}

.product-left{
    display:flex;
    align-items:center;
    gap:15px;
}

.product-image{
    width:80px;
    height:80px;
    border-radius:18px;
    overflow:hidden;
    background:#eee;
}

.product-image img{
    width:100%;
    height:100%;
    object-fit:cover;
}

.product-name{
    font-size:20px;
    font-weight:bold;
    color:#4a3434;
}

.product-qty{
    background:#ffe7d6;
    color:#d48c6a;
    padding:8px 14px;
    border-radius:30px;
    font-weight:bold;
}

/* EMPTY */

.empty-orders{
    background:white;
    padding:60px 30px;
    border-radius:30px;
    text-align:center;
    box-shadow:0 8px 20px rgba(0,0,0,0.06);
}

.empty-orders p{
    font-size:22px;
    color:#777;
}

/* MOBILE */

@media(max-width:768px){

    .orders-title{
        font-size:40px;
    }

    .product-item{
        flex-direction:column;
        align-items:flex-start;
        gap:15px;
    }

    .order-total{
        font-size:26px;
    }

}

</style>

</head>

<body>

<%- include("partials/navbar") %>

<div class="container">

    <h1 class="orders-title">
        Your Orders 📦
    </h1>

    <% if(orders.length === 0){ %>

        <div class="empty-orders">

            <p>
                No orders yet 🧸
            </p>

        </div>

    <% } else { %>

        <% orders.forEach(order => { %>

            <div class="order-card">

                <div class="order-header">

                    <div class="order-total">
                        ₹ <%= order.totalAmount %>
                    </div>

                    <div class="order-badge">
                        Order Placed ✨
                    </div>

                </div>

                <div class="order-products">

                    <% order.products.forEach(item => { %>

                        <% if(item.product){ %>

                            <div class="product-item">

                                <div class="product-left">

                                    <div class="product-image">

                                        <% if(item.product.image && item.product.image.length > 0){ %>

                                            <img src="/uploads/<%= item.product.image[0] %>">

                                        <% } else { %>

                                            <img src="https://via.placeholder.com/300">

                                        <% } %>

                                    </div>

                                    <div class="product-name">
                                        <%= item.product.name %>
                                    </div>

                                </div>

                                <div class="product-qty">
                                    x<%= item.quantity %>
                                </div>

                            </div>

                        <% } %>

                    <% }) %>

                </div>

            </div>

        <% }) %>

    <% } %>

</div>

</body>
</html>