    <style>

     body{
    font-family:'Fredoka', sans-serif;
    background:#fff7f2;
    margin:0;
    color:#333;
}



/* CONTAINER */

.container{
    padding:30px 6%;
}

/* TOP BANNER */

.shop-banner{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:20px;
    margin-bottom:35px;
}

.shop-banner img{
    width:100%;
    height:320px;
    object-fit:cover;
    border-radius:30px;
    box-shadow:0 8px 20px rgba(0,0,0,0.08);
}

/* CATEGORY PILLS */

.category-pills{
    display:flex;
    gap:15px;
    overflow-x:auto;
    white-space:nowrap;
    padding:15px 5px 25px;
    scrollbar-width:none;
    margin-bottom:40px;
    scroll-behavior:smooth;
}

.category-pills::-webkit-scrollbar{
    display:none;
}

.category-pill{
    flex-shrink:0;
    padding:12px 22px;
    border-radius:40px;
    background:white;
    text-decoration:none;
    color:#444;
    font-weight:bold;
    box-shadow:0 4px 10px rgba(0,0,0,0.06);
    transition:0.3s;
}

.category-pill:hover{
    background:#f3c8aa;
    color:white;
    transform:translateY(-3px);
}

/* PRODUCTS */

.products{
    display:grid;
    grid-template-columns:repeat(auto-fill,minmax(280px,1fr));
    gap:40px;
    align-items:start;
    padding:50px; 
}

/* PRODUCT CARD */

.card{
    background:#fffaf7;
    border-radius:28px;
    overflow:hidden;
    transition:0.3s;
    border:2px solid #fff;
    box-shadow:0 6px 20px rgba(0,0,0,0.06);
    height:100%;
display:flex;
flex-direction:column;
justify-content:space-between;
}

.card:hover{
    transform:translateY(-8px);
}

/* IMAGE */

.card-image{
    width:100%;
    height:320px;
    overflow:hidden;
}

.card-image img{
    width:100%;
    height:100%;
    object-fit:cover;
    transition:0.4s;
    background:#f8f8f8;
}

.card:hover img{
    transform:scale(1.05);
}

/* CONTENT */

.card-content{
    padding:20px;
    flex:1;
display:flex;
flex-direction:column;
justify-content:space-between;
}

.product-name{
    font-size:22px;
    font-weight:bold;
    margin-bottom:10px;

    display:-webkit-box;
    -webkit-line-clamp:2;
    line-clamp:2;
    -webkit-box-orient:vertical;
    overflow:hidden;
    min-height:55px;
    }


.rating{
    color:#ff9f43;
    font-weight:bold;
    margin-bottom:10px;
}

.price{
    font-size:24px;
    color:#d48c6a;
    font-weight:bold;
    margin-bottom:8px;
}

.category{
    color:#777;
    margin-bottom:18px;
}

/* BUTTONS */

.product-actions{
    display:flex;
    gap:12px;
    align-items:center;
}

.btn{
    flex:1;
    border:none;
    padding:12px;
    border-radius:15px;
    cursor:pointer;
    font-weight:bold;
    transition:0.3s;
}

.cart-btn{
    background:#f3c8aa;
    color:white;
}

.cart-btn:hover{
    background:#dfac89;
}

.wishlist-btn{
    width:50px;
    background:#ffe1ea;
    color:#ff4f81;
    font-size:20px;
}

.wishlist-btn:hover{
    background:#ffd0de;
}

        .shop-title{
    font-size:55px;
    text-align:center;
    margin-bottom:15px;
    color:#4a3434;
    font-family:'Pacifico', cursive;
}

.shop-sub{
    text-align:center;
    color:#777;
    margin-bottom:40px;
    font-size:18px;
}


.banner-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:25px;
    margin-bottom:50px;
}

.banner-grid img{
    width:100%;
    height:350px;
    object-fit:cover;
    border-radius:30px;
    box-shadow:0 10px 25px rgba(0,0,0,0.08);
}

.banner-card{
    position:relative;
    overflow:hidden;
    border-radius:30px;
     animation:floaty 4s ease-in-out infinite;
}

.banner-card img{
    width:100%;
    height:350px;
    object-fit:cover;
    transition:0.4s;
}

.banner-card:hover img{
    transform:scale(1.05);
}

.banner-overlay{
    position:absolute;
    inset:0;
    background:linear-gradient(
        to top,
        rgba(0,0,0,0.55),
        rgba(0,0,0,0.1)
    );
    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:center;
    color:white;
}

.banner-overlay h2{
    font-size:42px;
    margin-bottom:20px;
    font-family:'Pacifico', cursive;
}

.banner-overlay a{
    background:white;
    color:#333;
    padding:12px 24px;
    border-radius:30px;
    text-decoration:none;
    font-weight:bold;
}

/* BUDGET SECTION */

.budget-section{
    margin:50px 0;
    background:linear-gradient(
        to right,
        #fff6f0,
        #fffaf7
    );
    padding:40px 25px;
    border-radius:35px;
    box-shadow:0 8px 25px rgba(0,0,0,0.05);
}

.budget-title{
    text-align:center;
    font-size:42px;
    font-family:'Pacifico', cursive;
    color:#5a3d3d;
    margin-bottom:35px;
}

.budget-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:25px;
}

.budget-card{
    background:white;
    border-radius:30px;
    padding:35px 20px;
    text-align:center;
    transition:0.3s;
    box-shadow:0 5px 18px rgba(0,0,0,0.06);
}

.budget-card:hover{
    transform:translateY(-6px);
}

.budget-card h2{
    color:#ff7a59;
    font-size:28px;
    margin-bottom:10px;
}

.budget-card h1{
    font-size:65px;
    color:#ff5c35;
    margin-bottom:20px;
}

.budget-card a{
    text-decoration:none;
    background:#f3c8aa;
    color:white;
    padding:12px 24px;
    border-radius:30px;
    font-weight:bold;
    display:inline-block;
    transition:0.3s;
}

.budget-card a:hover{
    background:#dfac89;
}

/* ADMIN BUTTONS */

.admin-buttons{
    display:flex;
    gap:10px;
    margin-top:18px;
}

.admin-buttons a{
    flex:1;
}

.admin-btn{
    width:100%;
    border:none;
    padding:11px;
    border-radius:14px;
    cursor:pointer;
    font-weight:bold;
    transition:0.3s;
}

.edit-btn{
    background:#ffd89e;
    color:#7a4d00;
}

.edit-btn:hover{
    background:#ffc76a;
}

.delete-btn{
    background:#ffd6de;
    color:#c92b5b;
}

.delete-btn:hover{
    background:#ffbfd0;
}

/* AI BUTTON */

.ai-chat-btn{
    position:fixed;
    bottom:25px;
    right:25px;
    width:65px;
    height:65px;
    background:#f3c8aa;
    border-radius:50%;
    display:flex;
    justify-content:center;
    align-items:center;
    font-size:28px;
    cursor:pointer;
    box-shadow:0 8px 20px rgba(0,0,0,0.15);
    z-index:9999;
}

/* CHATBOX */

.chatbox{
    position:fixed;
    bottom:105px;
    right:25px;
    width:340px;
    height:500px;
    background:white;
    border-radius:30px;
    overflow:hidden;
    box-shadow:0 10px 30px rgba(0,0,0,0.15);
    display:none;
    flex-direction:column;
    z-index:9999;
}

.chat-header{
    background:#f3c8aa;
    color:white;
    padding:18px;
    font-size:20px;
    font-weight:bold;
}

.chat-messages{
    flex:1;
    padding:15px;
    overflow-y:auto;
    background:#fffaf7;
}

.bot-msg,
.user-msg{
    padding:12px 16px;
    border-radius:18px;
    margin-bottom:12px;
    width:max-content;
    max-width:80%;
}

.bot-msg{
    background:white;
}

.user-msg{
    background:#f3c8aa;
    color:white;
    margin-left:auto;
}

.chat-input-area{
    display:flex;
    border-top:1px solid #eee;
}

.chat-input-area input{
    flex:1;
    border:none;
    padding:15px;
    outline:none;
}

.chat-input-area button{
    border:none;
    background:#f3c8aa;
    color:white;
    padding:0 20px;
    cursor:pointer;
}



/* MOBILE */

@media(max-width:768px){

    .shop-banner{
        grid-template-columns:1fr;
    }

    .shop-banner img{
        height:220px;
    }

    .products{
        grid-template-columns:1fr 1fr;
        gap:15px;
    }

    .card-image{
        height:190px;
    }

    .product-name{
        font-size:16px;
    }

    .price{
        font-size:18px;
    }
    .budget-grid{
        grid-template-columns:1fr;
    }

    .budget-card h1{
        font-size:48px;
    }

} 

@keyframes floaty{

    0%{
        transform:translateY(0px);
    }

    50%{
        transform:translateY(-8px);
    }

    100%{
        transform:translateY(0px);
    }

}

    </style>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>

