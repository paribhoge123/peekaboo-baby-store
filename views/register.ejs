<!DOCTYPE html>
<html>
<head>

    <title>Register</title>

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="preconnect" href="https://fonts.googleapis.com">

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@300..700&display=swap" rel="stylesheet">

    <style>

        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
        }

        body{
            height:100vh;
            display:flex;
            justify-content:center;
            align-items:center;
            background:linear-gradient(
                to bottom,
                #fff7f2,
                #fdf6ef
            );
            font-family:'Fredoka', sans-serif;
        }

        .register-box{
            background:white;
            padding:50px;
            width:420px;
            border-radius:30px;
            box-shadow:0 10px 30px rgba(0,0,0,0.1);
            text-align:center;
        }

        .emoji{
            font-size:55px;
            margin-bottom:15px;
        }

        h1{
            color:#d48c6a;
            margin-bottom:10px;
            font-size:40px;
        }

        p{
            color:#777;
            margin-bottom:30px;
        }

        input{
            width:100%;
            padding:14px;
            margin:12px 0;
            border-radius:15px;
            border:1px solid #ddd;
            font-size:16px;
            outline:none;
            transition:0.3s;
        }

        input:focus{
            border:1px solid #d48c6a;
            box-shadow:0 0 10px rgba(212,140,106,0.2);
        }

        button{
            width:100%;
            padding:14px;
            border:none;
            border-radius:30px;
            background:#e8b89b;
            color:white;
            font-size:16px;
            font-weight:bold;
            cursor:pointer;
            margin-top:15px;
            transition:0.3s;
        }

        button:hover{
            background:#d79f7d;
            transform:translateY(-2px);
        }

        .bottom-text{
            margin-top:20px;
            color:#666;
        }

        .bottom-text a{
            color:#d48c6a;
            text-decoration:none;
            font-weight:bold;
        }

    </style>

</head>

<body>

    <div class="register-box">

        <div class="emoji">
            🎀
        </div>

        <h1>
            Create Account
        </h1>

        <p>
            Join Peekaboo and start shopping cute baby essentials 💖
        </p>

        <form action="/users/register" method="POST">

            <input 
                type="text" 
                name="fullname" 
                placeholder="Full Name" 
                required 
            />

            <input 
                type="email" 
                name="email" 
                placeholder="Email Address" 
                required 
            />

            <input 
                type="password" 
                name="password" 
                placeholder="Create Password" 
                required 
            />

            <button type="submit">
                Register
            </button>

        </form>

        <div class="bottom-text">

            Already have an account?

            <a href="/users/login">
                Login
            </a>

        </div>

    </div>

</body>
</html>